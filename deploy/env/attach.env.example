# Existing Identity and Asset; only Resource and its PostgreSQL are managed.
RESOURCE_POSTGRES_USER=resource
RESOURCE_POSTGRES_PASSWORD=
RESOURCE_POSTGRES_DB=resource
RESOURCE_DATABASE_URL=postgres://resource:${RESOURCE_POSTGRES_PASSWORD}@resource-postgres:5432/resource?sslmode=disable
RESOURCE_API_PORT=8083
RESOURCE_WEB_PORT=3001
RESOURCE_PUBLIC_ORIGIN=http://localhost:3001
RESOURCE_SITE_KEY=resource-main
RESOURCE_SITE_BRAND=月离资源
RESOURCE_SITE_DOMAIN=resource.localhost
RESOURCE_SITE_DESCRIPTION=软件、设计素材与脚本
RESOURCE_WEB_SEAL_SECRET=
RESOURCE_COOKIE_SECURE=false
RESOURCE_ADMIN_SUB=
RESOURCE_BOOTSTRAP_ADMIN_SUBS=["${RESOURCE_ADMIN_SUB}"]

RESOURCE_IDENTITY_ISSUER=https://identity.example.com
RESOURCE_IDENTITY_INTERNAL_URL=https://identity.example.com
RESOURCE_IDENTITY_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration
RESOURCE_IDENTITY_JWKS_URL=https://identity.example.com/oauth2/jwks.json
RESOURCE_ACCOUNT_ORIGIN=https://account.example.com
RESOURCE_OIDC_CLIENT_ID=resource-main-web
RESOURCE_OIDC_REDIRECT_URI=http://localhost:3001/auth/callback
RESOURCE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3001/
RESOURCE_ALLOW_LOOPBACK_IDENTITY_HTTP=false
RESOURCE_BINDING_ALLOW_INSECURE_IDENTITY_HTTP=false

RESOURCE_ASSET_INTERNAL_URL=https://asset.example.com
RESOURCE_ASSET_SPACE=yueli
RESOURCE_ASSET_NAMESPACE=resource-main
RESOURCE_ASSET_PROFILE=resource
RESOURCE_COVER_CATEGORY=resource-cover
RESOURCE_BINDING_ALLOW_INSECURE_ASSET_HTTP=false

RESOURCE_ENVIRONMENT=local
OTEL_TRACES_EXPORTER=none
