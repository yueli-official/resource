# Resource complete standalone topology.
RESOURCE_POSTGRES_USER=resource
RESOURCE_POSTGRES_PASSWORD=
RESOURCE_POSTGRES_DB=resource
RESOURCE_DATABASE_URL=postgres://resource:${RESOURCE_POSTGRES_PASSWORD}@resource-postgres:5432/resource?sslmode=disable
RESOURCE_API_PORT=8083
RESOURCE_WEB_PORT=3001
RESOURCE_PUBLIC_ORIGIN=http://localhost:3001
RESOURCE_SITE_KEY=resource-main
RESOURCE_SITE_BRAND=月离资源
RESOURCE_SITE_DOMAIN=resource.localhost
RESOURCE_SITE_DESCRIPTION=软件、设计素材与脚本
RESOURCE_WEB_SEAL_SECRET=
RESOURCE_COOKIE_SECURE=false

RESOURCE_ADMIN_SUB=
RESOURCE_ADMIN_EMAIL=
RESOURCE_ADMIN_PASSWORD=
RESOURCE_ADMIN_DISPLAY_NAME=Resource Administrator
RESOURCE_BOOTSTRAP_ADMIN_SUBS=["${RESOURCE_ADMIN_SUB}"]

IDENTITY_POSTGRES_USER=identity
IDENTITY_POSTGRES_PASSWORD=
IDENTITY_POSTGRES_DB=identity
IDENTITY_DATABASE_URL=postgres://identity:${IDENTITY_POSTGRES_PASSWORD}@identity-postgres:5432/identity?sslmode=disable
IDENTITY_GLOBAL_SECRET=
IDENTITY_PORT=8081
IDENTITY_ACCOUNT_PORT=3000
IDENTITY_COOKIE_SECURE=false
IDENTITY_WEBAUTHN_RPID=localhost
IDENTITY_WEBAUTHN_ORIGINS=["http://localhost:3000"]
IDENTITY_ALLOW_PRIVATE_HTTP_REDIRECTS=false
RESOURCE_IDENTITY_ISSUER=http://localhost:8081
RESOURCE_IDENTITY_INTERNAL_URL=http://identity:8081
RESOURCE_IDENTITY_DISCOVERY_URL=https://identity-internal:8443/.well-known/openid-configuration
RESOURCE_IDENTITY_JWKS_URL=https://identity-internal:8443/oauth2/jwks.json
RESOURCE_ACCOUNT_ORIGIN=http://localhost:3000
RESOURCE_OIDC_CLIENT_ID=resource-main-web
RESOURCE_OIDC_REDIRECT_URI=http://localhost:3001/auth/callback
RESOURCE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3001/
RESOURCE_BINDING_ALLOW_INSECURE_IDENTITY_HTTP=false
RESOURCE_ALLOW_LOOPBACK_IDENTITY_HTTP=false

ASSET_POSTGRES_USER=asset
ASSET_POSTGRES_PASSWORD=
ASSET_POSTGRES_DB=asset
ASSET_DATABASE_URL=postgres://asset:${ASSET_POSTGRES_PASSWORD}@asset-postgres:5432/asset?sslmode=disable
ASSET_UPLOAD_SECRET=
ASSET_STORAGE_CONFIG_SECRET=
ASSET_PORT=8082
RESOURCE_ASSET_INTERNAL_URL=http://asset:8082
RESOURCE_ASSET_PUBLIC_ORIGIN=http://localhost:8082
RESOURCE_ASSET_SPACE=yueli
RESOURCE_ASSET_NAMESPACE=resource-main
RESOURCE_ASSET_PROFILE=resource-default
RESOURCE_COVER_CATEGORY=resource-cover
RESOURCE_ASSET_CLIENT_ID=resource-asset-svc
RESOURCE_ASSET_CLIENT_SECRET=
RESOURCE_ASSET_SCOPE=asset:sign
RESOURCE_BINDING_ALLOW_INSECURE_ASSET_HTTP=true
ASSET_ALLOW_LOOPBACK_IDENTITY_HTTP=false

RESOURCE_ENVIRONMENT=local
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_ENDPOINT=
